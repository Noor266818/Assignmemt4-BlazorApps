@inherits LayoutComponentBase

<div class="app-canvas">
    <aside class="sidebar-container">
        <NavMenu />
    </aside>
    <main class="content-container">
        @Body
    </main>
</div>

<style>
    /* Reset overriding default layouts completely */
    .sidebar, .top-row {
        display: none !important;
    }

    .page {
        display: block !important;
    }

    .app-canvas {
        display: flex;
        min-height: 100vh;
        width: 100vw;
        position: fixed;
        top: 0;
        left: 0;
        background: #4c0519; /* Solid Beautiful Dark Rose Velvet Canvas */
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .sidebar-container {
        width: 260px;
        min-width: 260px;
        height: 100vh;
        background: #881337;
        border-right: 2px solid #9d174d;
        z-index: 99;
    }

    .content-container {
        flex: 1;
        height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        background: #4c0519;
    }
</style>