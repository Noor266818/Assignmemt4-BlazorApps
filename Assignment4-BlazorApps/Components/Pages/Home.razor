@page "/"
@rendermode InteractiveServer

<nav class="top-navbar">
    <div class="nav-left">
        <span class="nav-title">🌸 Greeting Panel Studio 🎀</span>
    </div>
    <div class="nav-right">
        <span class="status-indicator">
            <span class="pulse-dot"></span> Live Session 💞
        </span>
    </div>
</nav>

<div class="main-workspace">
    <div class="aesthetic-card">
        <div class="card-header">
            <h3>Personalized Greeting Studio 🎨🌸</h3>
            <p>Select your preferred greeting style and enter your name.</p>
        </div>

        <div class="input-wrapper mb-4">
            <label>GREETING TYPE 🏷️</label>
            <div class="select-field-container">
                <select class="custom-select" @bind="selectedGreetingType">
                    <option value="Welcome">Standard Welcome 🏠💝</option>
                    <option value="Professional">Professional Salutation 💼✨</option>
                    <option value="Casual">Casual / Friendly 👋🍿</option>
                    <option value="Inspirational">Inspirational Quote ✨🌈</option>
                </select>
            </div>
        </div>

        <div class="input-wrapper">
            <label>YOUR NAME ✍️💖</label>
            <div class="input-field-container">
                <input type="text" class="custom-input"
                       @bind="userName"
                       @bind:event="oninput"
                       placeholder="Type your beautiful name here..." />
            </div>
        </div>

        <div class="output-display-box @(string.IsNullOrWhiteSpace(userName) ? "" : "has-content")">
            @if (!string.IsNullOrWhiteSpace(userName))
            {
                <div class="greeting-text">
                    @GetGeneratedGreeting()
                </div>
            }
            else
            {
                <div class="placeholder-text">
                    Waiting for your name to sprinkle magic... 🪄✨🌸
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Top Navbar Styling */
    .top-navbar {
        width: 100%;
        padding: 18px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        border-bottom: 2px solid rgba(255, 255, 255, 0.3);
    }

    .nav-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: #ffffff;
        text-shadow: 0 2px 4px rgba(236, 72, 153, 0.3);
    }

    .status-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        color: #ffffff;
        background: #ff49db; /* Barbie Pink */
        padding: 6px 14px;
        border-radius: 20px;
        box-shadow: 0 4px 10px rgba(255, 73, 219, 0.3);
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background: #ffffff;
        border-radius: 50%;
        animation: pulseAnimation 2s infinite;
    }

    @@keyframes pulseAnimation {
        0% {
            transform: scale(0.95);
            opacity: 0.6;
        }

        50% {
            transform: scale(1.3);
            opacity: 1;
        }

        100% {
            transform: scale(0.95);
            opacity: 0.6;
        }
    }

    /* Main Workspace Layout */
    .main-workspace {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: start;
        flex-grow: 1;
        padding-top: 5%;
    }

    
    .aesthetic-card {
        width: 100%;
        max-width: 520px;
        background: #ffffff; /* Bright white card to let pinks pop */
        border: 4px solid #ff49db; /* Barbie Pink Border */
        border-radius: 28px;
        padding: 40px;
        box-shadow: 0 20px 40px rgba(236, 72, 153, 0.2);
    }

    .card-header h3 {
        margin: 0 0 6px 0;
        font-size: 1.45rem;
        font-weight: 800;
        color: #ec4899; /* Deep Rose Pink */
    }

    .card-header p {
        margin: 0 0 32px 0;
        font-size: 0.95rem;
        color: #f472b6;
        font-weight: 600;
    }

    /* Inputs Styling */
    .input-wrapper {
        margin-bottom: 24px;
    }

        .input-wrapper label {
            display: block;
            font-size: 0.8rem;
            font-weight: 800;
            color: #ec4899;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

    .custom-input, .custom-select {
        width: 100%;
        padding: 14px 16px;
        background: #fff5f7;
        border: 2px solid #fbcfe8;
        border-radius: 14px;
        color: #db2777;
        font-size: 1rem;
        font-weight: 700;
        outline: none;
        transition: all 0.2s;
    }

        .custom-input::placeholder {
            color: #f472b6;
            opacity: 0.6;
        }

        .custom-input:focus, .custom-select:focus {
            border-color: #ff49db;
            background: #ffffff;
            box-shadow: 0 0 12px rgba(255, 73, 219, 0.25);
        }

        .custom-select option {
            background: #ffffff;
            color: #ec4899;
        }

    /* Custom Pink Dropdown Arrow */
    .custom-select {
        appearance: none;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' fill='none' stroke='%23ff49db' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'></polyline></svg>");
        background-repeat: no-repeat;
        background-position: right 16px center;
        background-size: 16px;
        padding-right: 40px;
        cursor: pointer;
    }

    /* Output Box */
    .output-display-box {
        margin-top: 28px;
        padding: 24px;
        background: #fff1f2;
        border: 2px dashed #f472b6;
        border-radius: 18px;
        min-height: 110px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .output-display-box.has-content {
           
            background: #ff49db;
            border: 2px solid #ff49db;
            box-shadow: 0 10px 25px rgba(255, 73, 219, 0.3);
        }

    .placeholder-text {
        color: #f472b6;
        font-size: 0.95rem;
        font-weight: 700;
        text-align: center;
    }

    .greeting-text {
        font-size: 1.15rem;
        font-weight: 700;
        color: #ffffff; 
        text-align: center;
        line-height: 1.6;
    }

    
    .highlight {
        color: #ff49db;
        font-weight: 900;
        background: #ffffff;
        padding: 4px 10px;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        display: inline-block;
    }
</style>

@code {
    private string userName { get; set; } = "";
    private string selectedGreetingType { get; set; } = "Welcome";

    private MarkupString GetGeneratedGreeting()
    {
        if (string.IsNullOrWhiteSpace(userName)) return (MarkupString)"";

        string message = selectedGreetingType switch
        {
            "Professional" => $"💼 Dear <span class='highlight'>✨ {userName} ✨</span>, we sincerely appreciate your presence and wish you an exceptionally productive session ahead! 🚀✨🌸",
            "Casual" => $"👋 Hey <span class='highlight'>🎈 {userName} 🎈</span>! What's up? It is absolutely awesome to see you dropping by today! Let's build something cool! 🎉🍿💞",
            "Inspirational" => $"✨ Believe you can and you are already halfway there, <span class='highlight'>💫 {userName} 💫</span>. Keep pushing forward, you got this! 🌈🏆🌟",
            _ => $"🏠 Welcome back, <span class='highlight'>🌸 {userName} 🌸</span>! It is truly wonderful to have you back here inside your workspace! 💝🎀"
        };

        return (MarkupString)message;
    }
}