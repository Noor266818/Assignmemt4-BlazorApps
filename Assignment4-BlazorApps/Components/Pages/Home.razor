@page "/"
@rendermode InteractiveServer

<nav class="top-navbar">
    <div class="nav-left">
        <span class="nav-title">🌸 Greeting Panel Studio</span>
    </div>
    <div class="nav-right">
        <span class="status-indicator">
            <span class="pulse-dot"></span> Active Session 💞
        </span>
    </div>
</nav>

<div class="main-workspace">
    <div class="aesthetic-card">
        <div class="card-header">
            <h3>Personalized Greeting Studio 🎨</h3>
            <p>Select your preferred greeting style and enter your name.</p>
        </div>

        <div class="input-wrapper mb-4">
            <label>GREETING TYPE 🏷️</label>
            <div class="select-field-container">
                <select class="custom-select" @bind="selectedGreetingType">
                    <option value="Welcome">Standard Welcome 🏠</option>
                    <option value="Professional">Professional Salutation 💼</option>
                    <option value="Casual">Casual / Friendly 👋</option>
                    <option value="Inspirational">Inspirational Quote ✨</option>
                </select>
            </div>
        </div>

        <div class="input-wrapper">
            <label>YOUR NAME ✍️</label>
            <div class="input-field-container">
                <input type="text" class="custom-input"
                       @bind="userName"
                       @bind:event="oninput"
                       placeholder="Type your beautiful name here..." />
            </div>
        </div>

        <div class="output-display-box @(string.IsNullOrWhiteSpace(userName) ? "" : "has-content")">
            @if (!string.IsNullOrWhiteSpace(userName))
            {
                <div class="greeting-text">
                    @GetGeneratedGreeting()
                </div>
            }
            else
            {
                <div class="placeholder-text">
                    Waiting for your name to sprinkle magic... 🪄✨
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Top Navbar Styling */
    .top-navbar {
        width: 100%;
        padding: 18px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #881337;
        border-bottom: 2px solid #9d174d;
    }

    .nav-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #ffffff;
    }

    .status-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        font-weight: 700;
        color: #ffffff;
        background: #9d174d;
        padding: 6px 14px;
        border-radius: 20px;
        border: 1px solid #db2777;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background: #f472b6; /* Light pink blinking dot */
        border-radius: 50%;
        box-shadow: 0 0 8px #f472b6;
        animation: pulseAnimation 2s infinite;
    }

    @@keyframes pulseAnimation {
        0% {
            transform: scale(0.95);
            opacity: 0.6;
        }

        50% {
            transform: scale(1.3);
            opacity: 1;
            box-shadow: 0 0 12px #f472b6;
        }

        100% {
            transform: scale(0.95);
            opacity: 0.6;
        }
    }

    /* Main Workspace Layout */
    .main-workspace {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: start;
        flex-grow: 1;
        padding-top: 5%;
    }

    /* Premium Minimal Card */
    .aesthetic-card {
        width: 100%;
        max-width: 500px;
        background: #9d174d; /* Elegant Dark Pink Card Background */
        border: 2px solid #db2777;
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 20px 40px rgba(76, 5, 25, 0.5);
    }

    .card-header h3 {
        margin: 0 0 6px 0;
        font-size: 1.4rem;
        font-weight: 800;
        color: #ffffff;
    }

    .card-header p {
        margin: 0 0 32px 0;
        font-size: 0.9rem;
        color: #fbcfe8; /* Light Pink Subtext */
    }

    /* Inputs Styling */
    .input-wrapper {
        margin-bottom: 22px;
    }

        .input-wrapper label {
            display: block;
            font-size: 0.75rem;
            font-weight: 800;
            color: #fbcfe8;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

    .custom-input, .custom-select {
        width: 100%;
        padding: 14px 16px;
        background: #881337; /* Dark pink input background */
        border: 2px solid #be185d;
        border-radius: 14px;
        color: #ffffff;
        font-size: 0.95rem;
        font-weight: 600;
        outline: none;
        transition: all 0.2s;
    }

        .custom-input::placeholder {
            color: #f472b6;
            opacity: 0.7;
        }

        .custom-input:focus, .custom-select:focus {
            border-color: #f472b6;
            background: #701a28;
            box-shadow: 0 0 12px rgba(244, 114, 182, 0.3);
        }

        /* Select option standard styling override suggestion */
        .custom-select option {
            background: #881337;
            color: #ffffff;
        }

    /* Dropdown Design */
    .custom-select {
        appearance: none;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' fill='none' stroke='%23f472b6' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'></polyline></svg>");
        background-repeat: no-repeat;
        background-position: right 16px center;
        background-size: 16px;
        padding-right: 40px;
        cursor: pointer;
    }

    /* Output Box */
    .output-display-box {
        margin-top: 28px;
        padding: 24px;
        background: #881337;
        border: 2px dashed #be185d;
        border-radius: 16px;
        min-height: 110px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .output-display-box.has-content {
            background: #fff5f7; /* Magical clean pop-up effect when text arrives */
            border: 2px solid #f9a8d4;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

    .placeholder-text {
        color: #f472b6;
        font-size: 0.9rem;
        font-weight: 600;
        text-align: center;
    }

    .greeting-text {
        font-size: 1.15rem;
        font-weight: 700;
        color: #9d174d; /* Bold Rose text on white response container */
        text-align: center;
        line-height: 1.6;
    }

    .highlight {
        color: #ffffff;
        font-weight: 800;
        background: #e11d48; /* Vibrant neon pink label badge */
        padding: 2px 8px;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(225, 29, 72, 0.2);
    }
</style>

@code {
    private string userName { get; set; } = "";
    private string selectedGreetingType { get; set; } = "Welcome";

    private MarkupString GetGeneratedGreeting()
    {
        if (string.IsNullOrWhiteSpace(userName)) return (MarkupString)"";

        string message = selectedGreetingType switch
        {
            "Professional" => $"💼 Dear <span class='highlight'>{userName}</span>, we sincerely appreciate your presence and wish you an exceptionally productive and successful session ahead! 🚀✨",
            "Casual" => $"👋 Hey <span class='highlight'>{userName}</span>! What's up? It is absolutely awesome to see you dropping by today! Let's build something cool! 🎉🍿",
            "Inspirational" => $"✨ Believe you can and you are already halfway there, <span class='highlight'>{userName}</span>. Keep pushing forward, you got this! 🌈🏆",
            _ => $"🏠 Welcome back, <span class='highlight'>{userName}</span>! It is truly wonderful to have you back here inside your workspace. 🌸💝"
        };

        return (MarkupString)message;
    }
}