@inherits LayoutComponentBase

<div class="app-viewport">
    <aside class="sidebar-wrapper">
        <NavMenu />
    </aside>
    <main class="workspace-viewport">
        @Body
    </main>
</div>

<style>
    /* Default template components ko inject hone se rokne ke liye strict global rules */
    .sidebar, .top-row, .navbar, .page {
        display: none !important;
    }

    /* Absolute screen framework grid layout */
    .app-viewport {
        display: flex;
        min-height: 100vh;
        width: 100vw;
        position: fixed;
        top: 0;
        left: 0;
        background: #041e33;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        overflow: hidden;
    }

    .sidebar-wrapper {
        width: 280px;
        min-width: 280px;
        height: 100vh;
        background: #062f4f;
        border-right: 1px solid #114b7a;
    }

    .workspace-viewport {
        flex: 1;
        height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
    }
</style>