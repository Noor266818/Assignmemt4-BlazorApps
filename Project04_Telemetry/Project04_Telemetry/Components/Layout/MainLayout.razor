@inherits LayoutComponentBase

<div class="app-viewport">
    <aside class="sidebar-wrapper">
        <NavMenu />
    </aside>

    <main class="workspace-viewport">
        @Body
    </main>
</div>

<style>
    
    .sidebar, .top-row, .navbar, .page {
        display: none !important;
    }

    .app-viewport {
        display: flex;
        min-height: 100vh;
        width: 100vw;
        position: fixed;
        top: 0;
        left: 0;
        background: #f1f5f9; /* Soft, clean professional off-white/light gray background */
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        overflow: hidden;
    }

    .sidebar-wrapper {
        width: 280px;
        min-width: 280px;
        height: 100vh;
        background: #0f172a; /* Sophisticated Deep Slate Blue Sidebar */
        border-right: 1px solid #e2e8f0;
    }

    .workspace-viewport {
        flex: 1;
        height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        background: #f8fafc; /* Crisp content workspace sheet color */
    }
</style>