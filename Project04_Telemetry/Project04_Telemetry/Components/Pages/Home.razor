@page "/"
@rendermode InteractiveServer

<nav class="top-navbar">
    <div class="nav-left">
        <span class="nav-title">Hardware Telemetry Bus</span>
    </div>
    <div class="nav-right">
        <span class="status-indicator"><span class="pulse-dot"></span> Core System Active</span>
    </div>
</nav>

<div class="main-workspace">
    <div class="aesthetic-card-panel">
        <div class="card-header-block">
            <h3>Event Matrix Engine Console</h3>
            <p>Monitors hardware execution pulses via click handlers, rendering one-way status feeds combined with an absolute two-way input field override loop.</p>
        </div>

        <div class="counter-display-mesh">
            <span class="metric-classification-lbl">CURRENT MATRIX PULSE REGISTER</span>
            <div class="huge-telemetry-digit">@telemetryCounter</div>
            <span class="status-badge">LIVE METRIC STREAM ACTIVE</span>
        </div>

        <button class="increment-trigger-btn" @onclick="FireCounter">⚡ Increment Counter Register</button>

        <div class="segment-divider">
            <span class="segment-title">SYSTEM OVERRIDE CONTROLS</span>
        </div>

        <div class="input-form-wrapper">
            <label>MANUAL VALUE OVERRIDE (TWO-WAY DATA BINDING)</label>
            <div class="numeric-input-element-holder">
                <input type="number" class="custom-input-field" @bind="telemetryCounter" @bind:event="oninput" placeholder="0" />
                <span class="input-unit-label">ticks</span>
            </div>
        </div>
    </div>
</div>

<style>
    /* Top Navbar: Clean Solid Frame */
    .top-navbar {
        width: 100%;
        padding: 20px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #0b0f19;
        border-bottom: 1px solid #1e293b;
    }

    .nav-title {
        font-size: 1rem;
        font-weight: 600;
        color: #94a3b8;
        letter-spacing: 0.5px;
    }

    .status-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.75rem;
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.08);
        padding: 6px 14px;
        border-radius: 20px;
        border: 1px solid rgba(56, 189, 248, 0.2);
        font-weight: 600;
    }

    .pulse-dot {
        width: 6px;
        height: 6px;
        background: #38bdf8;
        border-radius: 50%;
        box-shadow: 0 0 8px #38bdf8;
    }

    
    .main-workspace {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: start;
        flex-grow: 1;
        padding: 5% 20px;
        background: #0f172a;
    }

   
    .aesthetic-card-panel {
        width: 100%;
        max-width: 480px;
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .card-header-block h3 {
        margin: 0 0 8px 0;
        font-size: 1.4rem;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.3px;
    }

    .card-header-block p {
        margin: 0 0 32px 0;
        font-size: 0.88rem;
        color: #94a3b8;
        line-height: 1.5;
    }

  
    .counter-display-mesh {
        background: #090d16;
        border: 1px solid #1e293b;
        padding: 28px 20px;
        border-radius: 18px;
        margin-bottom: 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
        box-shadow: inset 0 2px 8px rgba(0,0,0,0.5);
    }

    .metric-classification-lbl {
        font-size: 0.65rem;
        font-weight: 700;
        color: #38bdf8;
        letter-spacing: 1.5px;
        text-align: center;
    }

   
    .huge-telemetry-digit {
        font-size: 5.5rem;
        font-weight: 800;
        color: #ffffff;
        font-family: system-ui, -apple-system, monospace;
        margin: 10px 0;
        line-height: 1;
        letter-spacing: -1.5px;
        text-shadow: 0 0 12px rgba(255, 255, 255, 0.1);
    }

    .status-badge {
        font-size: 0.62rem;
        font-weight: 800;
        color: #06b6d4;
        background: rgba(6, 182, 212, 0.15);
        padding: 4px 10px;
        border-radius: 6px;
        letter-spacing: 0.8px;
    }

    
    .increment-trigger-btn {
        width: 100%;
        padding: 16px;
        background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
        border: none;
        border-radius: 12px;
        color: #0f172a;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        box-shadow: 0 4px 14px rgba(6, 182, 212, 0.3);
    }

        .increment-trigger-btn:hover {
            background: linear-gradient(135deg, #22d3ee 0%, #06b6d4 100%);
            box-shadow: 0 6px 20px rgba(6, 182, 212, 0.45);
            transform: translateY(-1px);
        }

        .increment-trigger-btn:active {
            transform: translateY(1px);
        }

    .segment-divider {
        height: 1px;
        background: #334155;
        margin: 36px 0;
        position: relative;
        text-align: center;
    }

    .segment-title {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: #1e293b;
        padding: 0 12px;
        font-size: 0.65rem;
        font-weight: 800;
        color: #64748b;
        letter-spacing: 1px;
    }

    /* Manual Controls Entry Configuration */
    .input-form-wrapper label {
        display: block;
        font-size: 0.72rem;
        font-weight: 700;
        color: #94a3b8;
        text-align: center;
        margin-bottom: 12px;
        letter-spacing: 0.5px;
    }

    .numeric-input-element-holder {
        position: relative;
        display: flex;
        align-items: center;
        max-width: 220px;
        margin: 0 auto;
    }

    .custom-input-field {
        width: 100%;
        padding: 14px 45px 14px 16px;
        background: #0f172a;
        border: 2px solid #334155;
        border-radius: 10px;
        color: #ffffff;
        font-size: 1.25rem;
        outline: none;
        font-weight: 700;
        text-align: center;
        transition: all 0.2s ease;
    }

        .custom-input-field:focus {
            border-color: #06b6d4;
            background: #090d16;
            box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.15);
        }

    .input-unit-label {
        position: absolute;
        right: 20px;
        font-size: 0.8rem;
        color: #475569;
        font-weight: 700;
    }

    .custom-input-field::-webkit-outer-spin-button, .custom-input-field::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
</style>

@code {
    private int telemetryCounter { get; set; } = 0;
    private void FireCounter() => telemetryCounter++;
}