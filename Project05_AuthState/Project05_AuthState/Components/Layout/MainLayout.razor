@inherits LayoutComponentBase
@using Project05_AuthState.Services
@inject AuthenticationStateService AuthService
@implements IDisposable

<div class="page">
    <div class="sidebar" style="background: linear-gradient(180deg, #14162e, #0d0e1f) !important;">
        <NavMenu />
    </div>

    <main style="background-color: #f1f5f9 !important;">
        <div class="top-row px-4" style="background-color: #ffffff !important; border-bottom: 1px solid #e2e8f0;">
            <div style="font-size: 0.8rem; font-weight: 700;">
                <span style="color: #94a3b8;">SYSTEM CORE</span> / <span style="color: #334155;">CONSOLE INTERFACE 💻</span>
            </div>
            <div style="background-color: #f0fdf4; border: 1px solid #bbf7d0; color: #16a34a; padding: 0.3rem 0.9rem; border-radius: 30px; font-size: 0.75rem; font-weight: 700;">
                CONNECTED
            </div>
        </div>

        <article class="content px-4" style="display: flex; justify-content: center; align-items: center; min-height: calc(100vh - 56px); padding: 2rem;">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnStateChanged += SynchronizeView;
    }

    private void SynchronizeView()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.OnStateChanged -= SynchronizeView;
    }
}