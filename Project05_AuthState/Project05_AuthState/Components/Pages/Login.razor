@page "/"
@page "/login"
@using Project05_AuthState.Services
@inject AuthenticationStateService AuthService
@rendermode InteractiveServer

<div style="background: linear-gradient(145deg, #181a30, #0f1122) !important; border: 2px solid #ff41b4 !important; border-radius: 24px; padding: 3rem 2.5rem; width: 100%; max-width: 450px; box-shadow: 0 20px 50px rgba(0,0,0,0.4); text-align: center;">

    <div style="font-size: 3rem; margin-bottom: 1.5rem; display: flex; justify-content: center; gap: 1rem; align-items: center;">
        <span style="color: #ff9f1c;">⚡</span> <span>🌸</span>
    </div>

    <h2 style="margin-bottom: 0.5rem; font-weight: 800; color: #ffffff !important; letter-spacing: 0.5px; font-size: 1.75rem;">Identity Access Terminal</h2>
    <p style="font-size: 0.9rem; color: #ff548f !important; font-weight: 500; margin-bottom: 2.5rem; line-height: 1.4;">
        Secure authentication state manager for shared global components.
    </p>

    @if (!AuthService.IsAuthenticated)
    {
        <div style="text-align: left; margin-bottom: 2rem;">
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #ffffff !important; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.75rem;">
                Operator Username ✍️
            </label>
            <input type="text" @bind="usernameInput" @bind:event="oninput" placeholder="e.g. Ali Ahmed"
                   style="width: 100%; padding: 1rem 1.25rem; background: rgba(15,17,34,0.7) !important; border: 2px solid #ff548f !important; border-radius: 12px; color: #ffffff !important; font-size: 1rem; box-sizing: border-box; outline: none;" />
        </div>

        <button @onclick="ProcessLogin" disabled="@string.IsNullOrWhiteSpace(usernameInput)"
                style="width: 100%; padding: 1rem; background: linear-gradient(90deg, #ff41b4, #ff548f) !important; color: white !important; border: none; font-weight: 700; font-size: 1rem; border-radius: 14px; cursor: pointer; box-shadow: 0 8px 25px rgba(255, 65, 180, 0.3); opacity: @(string.IsNullOrWhiteSpace(usernameInput) ? "0.5" : "1"); transition: all 0.2s;">
            Establish Session 🚀
        </button>
    }
    else
    {
        <div style="background: rgba(46, 196, 182, 0.1) !important; border: 2px solid #2ec4b6 !important; color: #2ec4b6 !important; border-radius: 14px; padding: 1rem; font-weight: 700; font-size: 1.05rem; margin-bottom: 2rem; box-shadow: 0 4px 15px rgba(46,196,182,0.15);">
            Authorized Session Active: @AuthService.CurrentUser
        </div>

        <button @onclick="ProcessLogout"
                style="width: 100%; padding: 1rem; background: linear-gradient(90deg, #e63946, #dc2626) !important; color: white !important; border: none; font-weight: 700; font-size: 1rem; border-radius: 14px; cursor: pointer; box-shadow: 0 8px 25px rgba(230, 57, 70, 0.3);">
            Terminate Session Token 🛑
        </button>
    }
</div>

@code {
    private string usernameInput = string.Empty;

    private void ProcessLogin()
    {
        if (!string.IsNullOrWhiteSpace(usernameInput))
        {
            AuthService.LogIn(usernameInput);
            usernameInput = string.Empty;
        }
    }

    private void ProcessLogout()
    {
        AuthService.LogOut();
    }
}