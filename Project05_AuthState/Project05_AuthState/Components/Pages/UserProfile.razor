@page "/userprofile"
@using Project05_AuthState.Services
@inject AuthenticationStateService AuthService
@implements IDisposable
@rendermode InteractiveServer

<div style="background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 24px; padding: 3.5rem 2.5rem; width: 100%; max-width: 480px; box-shadow: 0 20px 50px rgba(15,23,42,0.04); text-align: center;">
    @if (AuthService.IsAuthenticated)
    {
        <div style="color: #16a34a; margin-bottom: 1.2rem;">
            <span style="font-size: 3.5rem; line-height: 1;">🔓</span>
        </div>
        <span style="background-color: #f0fdf4; border: 1px solid #bbf7d0; color: #16a34a; padding: 0.4rem 1.1rem; border-radius: 20px; font-size: 0.75rem; font-weight: 800; letter-spacing: 1px;">ACCESS GRANTED</span>

        <h2 style="color: #0f172a; font-weight: 700; font-size: 1.85rem; margin-top: 1.5rem; margin-bottom: 0.5rem;">Welcome Back, @AuthService.CurrentUser!</h2>
        <p style="color: #475569; font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem; padding: 0 0.5rem;">Global user session initialized securely. Your clearance level allows full component state synchronization.</p>

        <div style="border-top: 1px solid #f1f5f9; padding-top: 1.2rem; color: #94a3b8; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.3px;">
            Active State: Singleton Memory Cache
        </div>
    }
    else
    {
        <div style="display: flex; justify-content: center; gap: 1rem; margin-bottom: 1.5rem; align-items: center;">
            <span style="font-size: 3.2rem; line-height: 1;">🔒</span>
            <span style="font-size: 3.2rem; line-height: 1;">🛑</span>
        </div>

        <div style="margin-bottom: 1.5rem;">
            <span style="background-color: #ef4444; color: #ffffff; padding: 0.4rem 1.2rem; border-radius: 20px; font-size: 0.75rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; box-shadow: 0 4px 10px rgba(239,68,68,0.25);">
                Restricted
            </span>
        </div>

        <h2 style="color: #0f172a; font-weight: 800; font-size: 1.8rem; margin-bottom: 0.75rem;">Authentication Required</h2>
        <p style="color: #475569; font-size: 0.95rem; line-height: 1.6; margin-bottom: 2.5rem; padding: 0 0.5rem;">No active user state found in memory. Please navigate to the Identity Terminal to log in.</p>

        <a href="/login" style="display: inline-block; width: 100%; max-width: 290px; padding: 0.95rem; border: none; border-radius: 14px; background: linear-gradient(135deg, #6366f1, #4f46e5); color: #ffffff; text-decoration: none; font-weight: 700; font-size: 0.95rem; box-shadow: 0 8px 20px rgba(99,102,241,0.3); display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin: 0 auto;">
            🔒 Go to Login Portal
        </a>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnStateChanged += OnStateChangedHandler;
    }

    private void OnStateChangedHandler()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.OnStateChanged -= OnStateChangedHandler;
    }
}