@inherits LayoutComponentBase
@using Project06_ConfigNotify.Services
@inject Project06_ConfigNotify.Services.ThemeStateManager ThemeManager
@implements System.IDisposable

<div class="fresh-master-root @ThemeManager.CurrentThemeClass">
    <div class="fresh-console-frame">

        <header class="fresh-header">
            <div class="brand-wrapper">
                <div class="glowing-core-dot"></div>
                <h1>Pipeline Configuration Hub</h1>
            </div>
            <div class="header-controls">
                <span class="cyber-ssl-pill">🔒 TLS 1.3 SECURE</span>
                <span class="fresh-status-tag">SYSTEM ONLINE</span>
                <button class="palette-toggle-btn" @onclick="ToggleActiveTheme">
                    🌓 Toggle Theme Mode
                </button>
            </div>
        </header>

        <div class="fresh-workspace">
            <aside class="fresh-sidebar">
                <Project06_ConfigNotify.Components.Layout.NavMenu />
            </aside>
            <main class="fresh-viewport">
                @Body
            </main>
        </div>

    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        ThemeManager.OnThemeStateChanged += RefreshLayoutState;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeManager.LoadSavedThemeAsync();
        }
    }

    private async Task ToggleActiveTheme()
    {
        await ThemeManager.ToggleThemeAsync();
    }

    private async void RefreshLayoutState()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeManager.OnThemeStateChanged -= RefreshLayoutState;
    }
}