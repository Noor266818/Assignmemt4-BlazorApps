@page "/notifications/settings"
@using Project06_ConfigNotify.Services
@inject Project06_ConfigNotify.Services.NotificationConfig Config
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

<div class="fresh-settings-card">
    <div class="pink-pill-badge">CONFIG NODE / SETTINGS</div>
    <h2>Terminal Feed Settings</h2>
    <p class="board-subtext">Manage your real-time dependency status overrides and stream filters safely.</p>

    <div class="settings-form-grid">
        <div class="form-group-node">
            <label>Notification Display Style</label>
            <select class="vibrant-input" @bind="Config.NotificationStyle">
                <option value="Detailed">Detailed View</option>
                <option value="Compact">Compact View</option>
            </select>
        </div>

        <div class="form-group-node">
            <label>Default Number of Notifications</label>
            <input type="number" class="vibrant-input" @bind="Config.DefaultNumberOfNotifications" min="1" max="5" />
        </div>

        <div class="form-group-node checkbox-row">
            <input type="checkbox" id="enableStream" class="vibrant-checkbox" checked />
            <label for="enableStream">Enable Live Telemetry Stream Broadcasting</label>
        </div>

        <button class="vibrant-action-btn" @onclick="SaveChanges">
            💾 Save Configuration
        </button>
    </div>
</div>

@code {
    private void SaveChanges()
    {
        Config.NotifyChanged();
    }
}

<style>
    .fresh-settings-card {
        background: #ffffff;
        border: 2px solid rgba(255, 101, 163, 0.1);
        padding: 40px;
        border-radius: 24px;
        max-width: 600px;
        width: 100%;
        text-align: left;
        box-shadow: 0 20px 40px rgba(148, 163, 184, 0.06);
    }

    .settings-form-grid {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-top: 25px;
    }

    .form-group-node {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .form-group-node label {
            font-size: 0.85rem;
            font-weight: 700;
            color: #0f172a;
        }

    .vibrant-input {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 12px 16px;
        border-radius: 12px;
        color: #0f172a;
        font-size: 0.9rem;
        outline: none;
        transition: border-color 0.2s;
    }

        .vibrant-input:focus {
            border-color: var(--candy-pink, #ff65a3);
            background: #fff5f7;
        }

    .checkbox-row {
        flex-direction: row;
        align-items: center;
        gap: 12px;
        margin: 10px 0;
    }

    .vibrant-checkbox {
        width: 18px;
        height: 18px;
        accent-color: var(--candy-pink, #ff65a3);
        cursor: pointer;
    }

    .vibrant-action-btn {
        background: linear-gradient(135deg, var(--candy-pink, #ff65a3), #ec4899);
        color: white;
        border: none;
        padding: 14px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        box-shadow: 0 8px 16px rgba(236, 72, 153, 0.25);
        transition: transform 0.2s;
    }

        .vibrant-action-btn:hover {
            transform: translateY(-2px);
        }
</style>