@page "/"
@namespace Project07_ThemeStateStore.Components.Pages

<div class="aesthetic-card-frame">
    <div style="font-size: 0.7rem; font-weight: 900; color: var(--candy-pink); background: rgba(255, 101, 163, 0.1); padding: 6px 14px; border-radius: 8px; display: inline-block; letter-spacing: 0.8px; border: 1px solid var(--border-line);">
        🌸 WORKSPACE OPERATIONAL
    </div>

    <h2 style="margin: 20px 0 12px 0; font-size: 1.8rem; font-weight: 800; color: var(--text-main); transition: color var(--transition-speed);">
        Dynamic Client State Console
    </h2>

    <p style="margin: 0 0 35px 0; font-size: 0.95rem; color: var(--text-sub); line-height: 1.6; transition: color var(--transition-speed);">
        Welcome to your adaptive environment node! Click the button at the top right header to instantly mutate state variables between Cotton Candy Pink and Midnight Deep themes.
    </p>

    <div style="display: flex; gap: 20px;">
        <div style="flex: 1; padding: 24px; border-radius: 16px; border: 1px solid var(--border-line); background: var(--inner-mint-bg); transition: background var(--transition-speed), border-color var(--transition-speed);">
            <div style="font-size: 1.4rem; margin-bottom: 12px;">⚡</div>
            <h4 style="margin: 0 0 6px 0; font-weight: 700; font-size: 1.05rem; color: var(--text-main);">State Engine</h4>
            <p style="margin: 0; font-size: 0.85rem; color: var(--text-sub); line-height: 1.5;">Persisted variables match local browser client schemas perfectly using native interop pipelines.</p>
        </div>

        <div style="flex: 1; padding: 24px; border-radius: 16px; border: 1px solid var(--border-line); background: var(--inner-pink-bg); transition: background var(--transition-speed), border-color var(--transition-speed);">
            <div style="font-size: 1.4rem; margin-bottom: 12px;">🌸</div>
            <h4 style="margin: 0 0 6px 0; font-weight: 700; font-size: 1.05rem; color: var(--text-main);">Fluid Colorway</h4>
            <p style="margin: 0; font-size: 0.85rem; color: var(--text-sub); line-height: 1.5;">Aesthetic interface layout balances updates without experiencing component flickering loops.</p>
        </div>
    </div>
</div>